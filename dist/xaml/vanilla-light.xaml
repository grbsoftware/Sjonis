<!-- UI Suite — vanilla / light — generated, do not edit -->
<!-- WinUI 3 / UWP. For WPF, x:Double needs
     xmlns:sys="clr-namespace:System;assembly=mscorlib" and sys:Double. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="UiBgColor">#FFFCFCFD</Color>
    <Color x:Key="UiSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="UiSurface2Color">#FFF4F6F8</Color>
    <Color x:Key="UiSurface3Color">#FFEAEEF2</Color>
    <Color x:Key="UiLineColor">#FFE3E8EC</Color>
    <Color x:Key="UiLineStrongColor">#FFC8D0D8</Color>
    <Color x:Key="UiTextColor">#FF15191D</Color>
    <Color x:Key="UiTextDimColor">#FF5A646E</Color>
    <Color x:Key="UiTextFaintColor">#FF8A939C</Color>
    <Color x:Key="UiAccentColor">#FF2F6FE4</Color>
    <Color x:Key="UiAccentHoverColor">#FF245BC4</Color>
    <Color x:Key="UiAccentInkColor">#FFFFFFFF</Color>
    <Color x:Key="UiAccentSoftColor">#FFE9F0FC</Color>
    <Color x:Key="UiGoodColor">#FF15803D</Color>
    <Color x:Key="UiGoodSoftColor">#FFE6F4EA</Color>
    <Color x:Key="UiWarnColor">#FFA16207</Color>
    <Color x:Key="UiWarnSoftColor">#FFFDF3E0</Color>
    <Color x:Key="UiCritColor">#FFB91C1C</Color>
    <Color x:Key="UiCritSoftColor">#FFFDEAEA</Color>
    <Color x:Key="UiInfoColor">#FF0369A1</Color>
    <Color x:Key="UiInfoSoftColor">#FFE5F2FA</Color>

    <SolidColorBrush x:Key="UiBg" Color="{StaticResource UiBgColor}" />
    <SolidColorBrush x:Key="UiSurface" Color="{StaticResource UiSurfaceColor}" />
    <SolidColorBrush x:Key="UiSurface2" Color="{StaticResource UiSurface2Color}" />
    <SolidColorBrush x:Key="UiSurface3" Color="{StaticResource UiSurface3Color}" />
    <SolidColorBrush x:Key="UiLine" Color="{StaticResource UiLineColor}" />
    <SolidColorBrush x:Key="UiLineStrong" Color="{StaticResource UiLineStrongColor}" />
    <SolidColorBrush x:Key="UiText" Color="{StaticResource UiTextColor}" />
    <SolidColorBrush x:Key="UiTextDim" Color="{StaticResource UiTextDimColor}" />
    <SolidColorBrush x:Key="UiTextFaint" Color="{StaticResource UiTextFaintColor}" />
    <SolidColorBrush x:Key="UiAccent" Color="{StaticResource UiAccentColor}" />
    <SolidColorBrush x:Key="UiAccentHover" Color="{StaticResource UiAccentHoverColor}" />
    <SolidColorBrush x:Key="UiAccentInk" Color="{StaticResource UiAccentInkColor}" />
    <SolidColorBrush x:Key="UiAccentSoft" Color="{StaticResource UiAccentSoftColor}" />
    <SolidColorBrush x:Key="UiGood" Color="{StaticResource UiGoodColor}" />
    <SolidColorBrush x:Key="UiGoodSoft" Color="{StaticResource UiGoodSoftColor}" />
    <SolidColorBrush x:Key="UiWarn" Color="{StaticResource UiWarnColor}" />
    <SolidColorBrush x:Key="UiWarnSoft" Color="{StaticResource UiWarnSoftColor}" />
    <SolidColorBrush x:Key="UiCrit" Color="{StaticResource UiCritColor}" />
    <SolidColorBrush x:Key="UiCritSoft" Color="{StaticResource UiCritSoftColor}" />
    <SolidColorBrush x:Key="UiInfo" Color="{StaticResource UiInfoColor}" />
    <SolidColorBrush x:Key="UiInfoSoft" Color="{StaticResource UiInfoSoftColor}" />

    <x:Double x:Key="UiRadiusSm">4</x:Double>
    <x:Double x:Key="UiRadius">7</x:Double>
    <x:Double x:Key="UiRadiusLg">12</x:Double>
    <x:Double x:Key="UiDensity">1</x:Double>
    <x:Double x:Key="UiFs">13.5</x:Double>
    <x:Double x:Key="UiWeightHeading">640</x:Double>
    <x:Double x:Key="UiTrackingLabel">.08</x:Double>

    <!-- Not expressible as a XAML resource: scheme, font, font-display, blur, ambient, shadow, shadow-lg
         Depth on Windows is Mica/Acrylic + ThemeShadow, set in code
         or on the element — not a brush. -->

</ResourceDictionary>
